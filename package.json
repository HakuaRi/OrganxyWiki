{
  "name": "wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue.js 模板驱动 Wiki 系统：展示系统与编辑系统共用一份内容数据与模板 Schema",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "public-site",
    "editor"
  ],
  "scripts": {
    "gen": "node scripts/build-index.ts",
    "check": "node scripts/build-index.ts && vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test shared/richtext/parse.test.ts editor/src/state/tree.test.ts editor/src/state/history.test.ts editor/src/state/editor.test.ts",
    "dev:public": "npm run dev --workspace public-site",
    "dev:editor": "npm run dev --workspace editor",
    "build:public": "npm run build --workspace public-site",
    "build:editor": "npm run build --workspace editor",
    "build:dist": "npm run build:public && npm run build:editor && node scripts/assemble-dist.ts",
    "build": "npm run build:public && npm run build:editor"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
